# ============================================================
# RoutineLens — ortam değişkenleri (ÖRNEK)
#
# Bu dosyayı kopyalayıp ".env" olarak kaydedin ve değerleri doldurun:
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# ".env" dosyası .gitignore ile korunur ve GitHub'a ASLA gönderilmez.
# ============================================================

# İlk kurulumda otomatik oluşturulan yönetici (admin) hesabının şifresi.
# GÜVENLİK: Güçlü bir şifre belirleyin; varsayılan değeri public depoda bırakmayın.
ROUTINELENS_ADMIN_SIFRE=guclu-bir-sifre-yazin

# (İsteğe bağlı) Ajanın veri göndereceği merkezi sunucu adresi.
# Varsayılan: http://127.0.0.1:8000
# ROUTINELENS_SUNUCU=http://192.168.1.10:8000

# (İsteğe bağlı) Veritabanı ve kayıt klasörü yolları.
# Docker içinde bunlar zaten /data altına ayarlanır; yerelde değiştirmeniz gerekmez.
# ROUTINELENS_DB=routinelens.db
# ROUTINELENS_KAYIT=kayitlar
